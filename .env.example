# Copiá este archivo como .env.local (no se sube a git). Todo NEXT_PUBLIC_* queda VISIBLE en el JS publicado:
# nunca pongas secretos acá.

# Subcarpeta del servidor (basePath). En desarrollo, vacía. En producción la define
# .github/workflows/deploy.yml (/waykipromo/admin).
NEXT_PUBLIC_BASE_PATH=

# API de Wayki Promo, terminada en /v1 y sin barra final (contrato: api-doc/contrato-api.html).
# Local con la API en php -S: http://localhost:8000/v1 · Producción: https://tucumanturismo.gob.ar/waykipromo/api/v1
NEXT_PUBLIC_API_URL=
# Etapas que usan la API real (lib/api.ts): sesion, catalogos, canje, promociones, comercios, usuarios, ente.
# Vacía → todo lo simula el navegador (lib/simulador.ts) y el login muestra los usuarios de prueba.
NEXT_PUBLIC_API_ETAPAS=
